/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers (added 2026-11-13). Browsers must use HTTPS, and other sites cannot put our pages
# (and their lead forms) inside a frame.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN

# Framed widgets are made to sit on installer and partner sites, so they drop the frame rules.
/embed/*
  ! Content-Security-Policy
  ! X-Frame-Options

/calculator/embed/*
  ! Content-Security-Policy
  ! X-Frame-Options

# Agent discovery (added 2026-11-26): RFC 8288 Link headers on the homepage, RFC 9727 API catalog.
/
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </api/openapi>; rel="service-desc"; type="application/openapi+json"
  Link: </api/>; rel="service-doc"; type="text/html"
  Link: </llms.txt>; rel="describedby"; type="text/plain"

/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *

/api/openapi
  Content-Type: application/openapi+json
  Access-Control-Allow-Origin: *
