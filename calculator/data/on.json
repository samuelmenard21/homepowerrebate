ion","amount":{"max":1250},"rules":"Up to $1,250 without a home energy assessment. The official page also shows lower steps by starting R-value.","when":{"insulation_scope":["attic"]},"group":"ins","status":"active","verified_on":"2026-09-26","source_url":"https://homerenovationsavings.ca/"},{"id":"hrs-ins-attic-assess","name":"Home Renovation Savings: attic insulation with assessment","upgrade":"insulation","amount":{"max":1500},"rules":"Needs a home energy assessment before and after. Pays $1,500, $1,200 or $900 depending on your starting R-value.","when":{"insulation_scope":["attic"]},"group":"ins","status":"active","verified_on":"2026-09-26","source_url":"https://homerenovationsavings.ca/with-assessment"},{"id":"hrs-ins-whole","name":"Home Renovation Savings: whole-home insulation with assessment","upgrade":"insulation","amount":{"max":7700},"rules":"Needs a home energy assessment before and after. Total insulation rebates are capped at $7,700. Walls, basement, crawlspace and more are paid by area.","when":{"insulation_scope":["whole"]},"group":"ins","status":"active","verified_on":"2026-09-26","source_url":"https://homerenovationsavings.ca/with-assessment"},{"id":"hrs-solar","name":"Home Renovation Savings: solar","upgrade":"solar","amount":{"max":5000},"rules":"$1,000 per kW, up to $5,000 and 50% of cost. You cannot also take a net-metering agreement with your utility.","status":"active","verified_on":"2026-09-26","source_url":"https://www.homerenovationsavings.ca/without-assessment/solar"},{"id":"hrs-battery","name":"Home Renovation Savings: battery","upgrade":"battery","amount":{"max":5000},"rules":"$300 per kWh, up to $5,000 and 50% of cost. Only with new solar. Solar and battery together are capped at $10,000.","requires":"hrs-solar","status":"active","verified_on":"2026-09-26","source_url":"https://www.homerenovationsavings.ca/without-assessment/solar"},{"id":"hrs-tstat","name":"Home Renovation Savings: smart thermostat","upgrade":"thermostat","amount":{"max":125},"rules":"Enbridge gas-heated home, or electrically heated or cooled home. Listed models only. Upload the receipt within 60 days. One thermostat rebate per home.","group":"tstat","status":"active","verified_on":"2026-09-26","source_url":"https://homerenovationsavings.ca/without-assessment/smart-thermostat"},{"id":"peak-perks","name":"Save on Energy Peak Perks","upgrade":"thermostat","amount":{"max":75},"rules":"$75 on enrolling, then $20 a year. Needs central AC or a heat pump run by an eligible Wi-Fi thermostat. Not for high-rise units.","group":"tstat","status":"active","verified_on":"2026-09-26","source_url":"https://saveonenergy.ca/For-Your-Home/Peak-Perks"},{"id":"hrs-appliances","name":"Home Renovation Savings: appliances","upgrade":"appliances","amount":{"label":"$25 to $200 each","max":0},"rules":"Heat pump dryer $200, induction cooktop or range $150, washer $75, fridge $50, freezer $50, dishwasher $25. Replace an existing electric appliance. Apply within 60 days.","status":"active","verified_on":"2026-09-26","source_url":"https://homerenovationsavings.ca/without-assessment/appliances"},{"id":"eap","name":"Energy Affordability Program (free upgrades)","upgrade":"support","amount":{"label":"Free","max":0},"rules":"Free upgrades for households under the income limits, from $48,220 for 1 person to $96,439 for 4 people, or on OW, ODSP or OESP. Call 1-844-770-3148.","status":"active","verified_on":"2026-09-26","source_url":"https://saveonenergy.ca/For-Your-Home/Energy-Affordability-Program"},{"id":"toronto-help","name":"Toronto Home Energy Loan Program","upgrade":"support","amount":{"label":"Loan up to $125,000","max":0},"rules":"A city loan repaid on your property tax bill, up to 10% of your home's assessed value, for up to 20 years. Confirm the current rate with the City.","when":{"loan":["toronto"]},"status":"active","verified_on":"2026-09-26","source_url":"https://www.toronto.ca/services-payments/water-environment/environmental-grants-incentives/home-energy-loan-program-help/"},{"id":"ottawa-loan","name":"Better Homes Ottawa loan","upgrade":"support","amount":{"label":"Loan up to $125,000","max":0},"rules":"Repaid on your property tax bill, up to 10% of your home's assessed value, 20 years. 0% for households under the income limits. Not for gas upgrades.","when":{"loan":["ottawa"]},"status":"active","verified_on":"2026-09-26","source_url":"https://ottawa.ca/en/city-hall/budget-finance-and-corporate-planning/funding/environmental-funding/better-homes-ottawa/better-homes-ottawa-loan-program"},{"id":"waterloo-loan","name":"RetrofitWR loan (GrandBridge customers)","upgrade":"support","amount":{"label":"Loan up to $40,000","max":0},"rules":"2.5% fixed for 10 or 15 years, repaid on your GrandBridge Energy bill. Only for GrandBridge customers in Cambridge and North Dumfries. A free Energy Coach is open to homeowners across Waterloo Region.","when":{"loan":["cambridge"]},"status":"active","verified_on":"2026-09-26","source_url":"https://www.regionofwaterloo.ca/programs-and-services/climate-and-environment/climate-action/retrofit-waterloo-region/"}],"notes":["A new gas furnace gets no Home Renovation Savings rebate.","Amounts are the most a program pays. Your rebate depends on the equipment, the work and your final invoice."],"closed":[{"name":"Canada Greener Homes Loan","status":"closed","source_url":"https://www.cghli.ca/"}],"income_source":null,"verified_on":"2026-09-26"}