name = "homepowerrebate-lead-router"
main = "lead-router.js"
compatibility_date = "2026-07-01"
compatibility_flags = ["nodejs_compat"]

# Bind the Worker to leads.homepowerrebate.com as a Custom Domain.
# custom_domain = true makes Wrangler auto-create the DNS record + SSL cert,
# so the subdomain actually resolves (a plain route does not create DNS).
routes = [
  { pattern = "leads.homepowerrebate.com", custom_domain = true }
]

# Environment variables (non-sensitive config goes here)
vars = { ENVIRONMENT = "production" }

# Daily drip-email queue (results-recap subscribers) — see runDripQueue() in lead-router.js.
# 15:00 UTC = 7am PT, well inside CASL's normal-hours guidance.
[triggers]
crons = ["0 15 * * *"]

# D1 database for verified outcomes (homeowner-submitted cost/savings data
# powering the neighbour / province / national comparison feature).
[[d1_databases]]
binding = "OUTCOMES_DB"
database_name = "homepowerrebate-outcomes"
database_id = "99c47c64-e375-44f7-ae4c-6cc2679624e6"

# D1 database for centralized rebate program data (source of truth for all city pages)
[[d1_databases]]
binding = "PROGRAMS_DB"
database_name = "homepowerrebate-programs"
database_id = "TBD"  # Will be created via wrangler d1 create

# Secrets are set via `wrangler secret put` in the terminal — not stored in this file
# Required secrets:
#   - RESEND_API_KEY          (from https://resend.com)
#   - GSHEET_WEBHOOK_URL      (from Google Apps Script)
#   - OPS_EMAIL               (operations inbox)
